{
  "name": "@threadable/shadcn",
  "version": "0.1.0",
  "private": true,
  "description": "Threadable's accessible shadcn-vue block registry for Laravel, Inertia and Vue",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/threadable/shadcn.git"
  },
  "scripts": {
    "registry:build": "pnpm registry:clean && shadcn-vue build registry.json --output public/r",
    "registry:clean": "rimraf public/r",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "test": "pnpm test:unit",
    "test:unit": "vitest run tests",
    "test:a11y": "vitest run tests/accessibility",
    "test:integration": "vitest run tests/integration",
    "test:browser": "playwright test tests/playwright/interaction.spec.ts tests/accessibility/field-keyboard.spec.ts",
    "test:axe": "playwright test tests/playwright/axe.spec.ts",
    "test:harness": "pnpm test:unit && pnpm test:browser && pnpm test:axe",
    "playground:dev": "vite --host 127.0.0.1 --port 4173",
    "playground:build": "vite build --config vite.config.ts",
    "playground:preview": "vite preview --config vite.config.ts --host 127.0.0.1 --port 4173",
    "upstream:sync": "pnpm exec shadcn-vue add --cwd playground --yes --overwrite @shadcn/button @shadcn/checkbox @shadcn/select @shadcn/label @shadcn/skeleton @shadcn/separator @shadcn/sheet @shadcn/stepper @shadcn/command @shadcn/popover @shadcn/dropdown-menu @shadcn/radio-group @shadcn/textarea @shadcn/alert-dialog @shadcn/input @shadcn/input-group @shadcn/calendar @shadcn/range-calendar @shadcn/tooltip",
    "check": "pnpm registry:build && pnpm typecheck && pnpm lint && pnpm test && pnpm test:a11y && pnpm test:integration && pnpm playground:build && pnpm test:browser && pnpm test:axe"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@inertiajs/core": "^3.0.3",
    "@inertiajs/vue3": "^3.0.3",
    "@internationalized/date": "^3.12.4",
    "@lucide/vue": "^1.18.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@vueuse/core": "^14.4.0",
    "base-vue-phone-input": "^0.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.1",
    "libphonenumber-js": "^1.13.15",
    "prettier": "^3.9.6",
    "reka-ui": "^2.10.3",
    "rimraf": "^6.1.3",
    "shadcn-vue": "^2.8.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.10"
  }
}
