{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "sheet-block",
  "description": "Threadable Inertia form sheet wrapper",
  "dependencies": [
    "@inertiajs/vue3",
    "reka-ui"
  ],
  "registryDependencies": [
    "@threadable/sheet"
  ],
  "files": [
    {
      "path": "registry/threadable/ui/sheet-block/SheetBlock.vue",
      "content": "<script setup lang=\"ts\">\nimport {\n  Sheet,\n  SheetContent,\n  SheetDescription,\n  SheetHeader,\n  SheetTitle,\n  SheetFooter,\n} from \"@/registry/threadable/ui/sheet\";\nimport { Form } from \"@inertiajs/vue3\";\nimport { ref, type Component } from \"vue\";\nimport { DialogClose } from \"reka-ui\";\n\ninterface Props {\n  open: boolean;\n  side?: \"left\" | \"right\" | \"top\" | \"bottom\";\n  customClass?: string;\n  title?: string;\n  titleAriaLabel?: string;\n  description?: string;\n  descriptionAriaLabel?: string;\n  icon?: Component;\n  isForm?: boolean;\n  formBind?: Record<string, unknown>;\n  dataTest?: string;\n}\n\nwithDefaults(defineProps<Props>(), {\n  side: \"right\",\n  customClass: \"w-full p-4 sm:max-w-lg\",\n  isForm: false,\n});\n\ndefineSlots<{\n  content(props: { processing: boolean; errors: Record<string, string> }): any;\n  footer(props: {\n    processing: boolean;\n    errors: Record<string, string>;\n    isDirty?: boolean;\n  }): any;\n}>();\n\nconst emit = defineEmits<{\n  (e: \"update:open\", value: boolean): void;\n  (e: \"formSuccess\"): void;\n}>();\n\nconst handleClose = () => {\n  emit(\"update:open\", false);\n};\n\nconst handleFormSuccess = () => {\n  emit(\"formSuccess\");\n};\n\nconst headerRef = ref<InstanceType<typeof SheetHeader> | null>(null);\n\nconst handleOpenAutoFocus = (event: Event) => {\n  event.preventDefault();\n  const el = headerRef.value?.$el as HTMLElement | undefined;\n  el?.focus();\n};\n</script>\n\n<template>\n  <Sheet :open=\"open\" @update:open=\"handleClose\">\n    <SheetContent\n      :side=\"side\"\n      :class=\"customClass\"\n      :data-test=\"dataTest || ''\"\n      @openAutoFocus=\"handleOpenAutoFocus\"\n    >\n      <DialogClose\n        aria-label=\"Close dialog\"\n        data-test=\"dialog-close-button\"\n        class=\"absolute top-4 right-4 rounded-xs opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:ring-2 focus:ring-ring focus:ring-offset-2 focus:outline-hidden disabled:pointer-events-none data-[state=open]:bg-secondary\"\n      >\n        <span class=\"sr-only\">Close</span>\n      </DialogClose>\n      <SheetHeader\n        v-if=\"title || description || icon\"\n        ref=\"headerRef\"\n        tabindex=\"0\"\n        class=\"text-left focus:outline-none\"\n      >\n        <div class=\"mb-6 flex items-start gap-2\">\n          <component\n            v-if=\"icon\"\n            :is=\"icon\"\n            class=\"h6 mt-1 -ml-3 w-6 shrink-0 text-primary\"\n          />\n          <div class=\"flex w-full flex-col gap-y-2\">\n            <SheetTitle\n              v-if=\"title\"\n              class=\"text-2xl font-normal\"\n              :title=\"title\"\n              :aria-label=\"titleAriaLabel || title\"\n            >\n              {{ title }}\n            </SheetTitle>\n            <SheetDescription\n              v-if=\"description\"\n              class=\"mr-4 break-words text-primary\"\n              :title=\"description\"\n              :aria-label=\"descriptionAriaLabel || description\"\n            >\n              {{ description }}\n            </SheetDescription>\n          </div>\n        </div>\n      </SheetHeader>\n\n      <template v-if=\"isForm\">\n        <Form\n          v-bind=\"formBind\"\n          v-slot=\"{ errors, processing, isDirty }\"\n          class=\"flex flex-1 flex-col overflow-hidden\"\n          novalidate\n          @success=\"() => handleFormSuccess()\"\n        >\n          <div class=\"flex-1 overflow-y-auto\">\n            <slot name=\"content\" :errors=\"errors\" :processing=\"processing\" />\n          </div>\n          <SheetFooter class=\"p-0\">\n            <slot\n              name=\"footer\"\n              :errors=\"errors\"\n              :processing=\"processing\"\n              :isDirty=\"isDirty\"\n            />\n          </SheetFooter>\n        </Form>\n      </template>\n\n      <template v-else>\n        <div class=\"flex-1 overflow-y-auto\">\n          <slot name=\"content\" :processing=\"false\" :errors=\"{}\" />\n        </div>\n        <SheetFooter class=\"p-0\">\n          <slot name=\"footer\" :processing=\"false\" :errors=\"{}\"></slot>\n        </SheetFooter>\n      </template>\n    </SheetContent>\n  </Sheet>\n</template>\n\n<style scoped>\n:deep([data-slot=\"sheet-content\"] > button:last-of-type) {\n  display: none !important;\n}\n</style>\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/threadable/ui/sheet-block/index.ts",
      "content": "export { default as SheetBlock } from \"./SheetBlock.vue\";\n\nexport const handleSheetClose = (\n  emit: (event: string, value: boolean) => void,\n) => {\n  return () => {\n    emit(\"close\", false);\n  };\n};\n",
      "type": "registry:ui"
    }
  ],
  "type": "registry:ui"
}
